# Copy to .env.local and fill in real values. Never commit .env.local —
# it's already gitignored. See docs/seo-and-infra.md "Environment
# variables" for the full explanation of each one.

# --- Sanity (required) ---
# Same project/dataset the campaigns subsite Worker also reads — see
# that repo's CLAUDE.md if you're setting up both.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-01

# Viewer role, server-only — never expose to the client, never prefix
# with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=your-read-token

# --- Site (required) ---
NEXT_PUBLIC_SITE_URL=https://www.criticalsandfumbles.com

# --- Analytics (optional) ---
# No-op if unset.
NEXT_PUBLIC_GA_ID=

# --- Sanity write access (optional — only for running migration/seed scripts) ---
# Editor role. Added 2026-08-11 for sanity/migrations/patch-unit-labels.ts.
# Not needed for normal dev/build. Server/script-only, never client-side.
# SANITY_API_WRITE_TOKEN=your-write-token

# --- Cloudflare Worker secrets (NOT read from .env.local — set these via
# `wrangler secret put <NAME>` instead, listed here only so they're
# discoverable) ---
# REVALIDATE_SECRET   — app/api/revalidate/route.ts, on-demand ISR revalidation
# WEBHOOK_SECRET       — workers/og-generator (separate Worker/npm project),
#                        gates its Sanity-publish-triggered OG image regeneration
